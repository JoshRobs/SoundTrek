generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Composer {
  slug        String   @id
  name        String
  bio         String?
  support_url String?
  image_url   String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@map("composers")
}

model ContactMessage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String?
  email      String
  message    String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("contact_messages")
}

model Submission {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  game_title   String
  notes        String?
  status       String   @default("pending")
  submitted_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("submissions")
}

model Soundtrack {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  game_title          String
  studio              String
  composers           String[]
  console             String
  release_year        Int
  cover_image_url     String?
  cover_image_url_hd  String?
  youtube_playlist_id String?
  youtube_video_id    String?
  source_type         String
  spotify_id          String?
  spotify_type        String?
  streaming_links     Json     @default("[]")
  genre_tags          String[]
  theme_tags          String[]
  keyword_tags        String[]
  likes               Int      @default(0)
  total_likes         Int?
  rating              Float?
  rating_count        Int?
  popularity          Float?
  slug                String?  @unique
  amazon_url          String?
  amazon_image_url    String?
  description         String?
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  @@map("soundtracks")
}

// Tracklist rows synced from YouTube playlists by scripts/sync-tracklists.ts.
// title is a snapshot taken at sync time; position is the 0-based playlist
// index. Replaced wholesale per soundtrack on each sync.
model Track {
  soundtrack_id String   @db.Uuid
  position      Int
  video_id      String
  title         String
  unavailable   Boolean  @default(false)
  synced_at     DateTime @default(now()) @db.Timestamptz(6)

  @@id([soundtrack_id, position])
  @@map("tracks")
}

// user_id references auth.users(id), managed by Supabase Auth — not modeled
// here since this app's Prisma schema only tracks the public schema.
model UserLike {
  user_id       String    @db.Uuid
  soundtrack_id String
  created_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@id([user_id, soundtrack_id])
  @@map("user_likes")
}

// Per-user listen history (migration 013). One row per (user, soundtrack) with
// played_at bumped on replay; backs the "Recently listened" rail and feeds
// content-based recommendations. user_id references auth.users(id) (Supabase
// Auth), kept as a bare column like UserLike above.
model ListenHistory {
  user_id       String   @db.Uuid
  soundtrack_id String   @db.Uuid
  played_at     DateTime @default(now()) @db.Timestamptz(6)

  @@id([user_id, soundtrack_id])
  @@map("listen_history")
}

// User-curated collections of soundtracks. Created originally in the Supabase
// dashboard (hence the legacy "playlist" constraint/index names in Postgres);
// first captured here alongside migration 012. user_id references
// auth.users(id) (Supabase Auth) and, as elsewhere in this schema, is kept as a
// bare column rather than a modeled cross-schema relation.
model Collection {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  description  String?
  creator_name String?
  user_id      String    @db.Uuid
  is_public    Boolean   @default(true)
  theme_tags   String[]  @default([])
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@map("collections")
}

// One entry in a collection. Polymorphic (migration 012): video_id NULL → the
// whole soundtrack (album item); video_id set → a single track from its
// playlist, with track_title snapshotted at add time. FKs (collection_id,
// soundtrack_id) are kept as bare columns to match Track/UserLike above.
//
// Uniqueness is enforced by two PARTIAL unique indexes — collection_items_album_uniq
// (collection_id, soundtrack_id) WHERE video_id IS NULL and collection_items_track_uniq
// (collection_id, video_id) WHERE video_id IS NOT NULL — which Prisma schema
// cannot express. They live in migration 012; do not replace them with a plain
// @@unique here, which would forbid multiple tracks from one soundtrack.
model CollectionItem {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collection_id String    @db.Uuid
  soundtrack_id String    @db.Uuid
  video_id      String?
  track_title   String?
  position      Int       @default(0)
  added_at      DateTime? @default(now()) @db.Timestamptz(6)

  @@map("collection_items")
}
